{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TYUT Keepalive",
  "version": "0.3.0",
  "identifier": "com.tyut.keepalive",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "TYUT 校园网保活", "width": 480, "height": 380, "minWidth": 360, "minHeight": 280, "resizable": true, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
